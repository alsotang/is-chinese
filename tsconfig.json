{
  "include": [
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2015",
    "module": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": []
  }
}
